---
// import { published } from "@data/post"

import Wrapper from "@components/Wrapper";
const { frontmatter } = Astro.props;
---

<meta charset="utf-8">
<Wrapper title="Disjunctions" noindex={true}>	
	<div class="relative grid grid-cols-12 w-full md:px-[5%]">
		<div class="text-block mx-auto max-w-[90ch] flex flex-col font-serif col-span-full md:col-span-8 md:col-start-3">
			<h1>support us</h1>
			<p>Thank you for considering supporting <i>Disjunctions</i>. Our magazine is currently run entirely by volunteers, and we are in the process of making it possible to receive donations.</p> 
			<p>We are always on the lookout for people interested in helping us navigate bureaucracy, web dev, social media and design. Please reach out to us at <a href="mailto:contact@disjunctionsmag.com">contact@disjunctionsmag.com</a> if you'd like to help out.</p>
		</div>
	</div>
</Wrapper>
