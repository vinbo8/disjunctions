---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { Image } from "astro:assets"

import Wrapper from "@components/Wrapper"
import ArticleBanner from "@components/ArticleBanner";

export async function getStaticPaths() {
	const blogEntries = await getCollection('articles') 
	return blogEntries.map((article) => {
		return {
			params: { article: article.slug},
			props: { article }
		};
	})
}

const { article } = Astro.props
const ogUrl = Astro.site.origin + article.data.image.src
const shortDate = new Date(article.data.date).toLocaleDateString("en-US", {month: "short", year: "2-digit"}).toLowerCase();
const { Content } = await article.render()
---

<Wrapper title={article.data.title} abstract={article.data.abstract} image={ogUrl}>
	<div class="flex flex-col items-center pb-8">
		<ArticleBanner entity={article} />
		<div class="relative grid grid-cols-12 w-full lg:px-[5%] overflow-x-hidden">
			<div class="hidden lg:block col-span-2"><Image id="sideslash" class="sticky top-[50vh] mt-[50vh] -translate-y-1/2 self-start" src="/img/slash.png" height="100" width="100" alt="" /></div>
			<div id="body-text" class="prose mx-auto min-w-0 max-w-full md:max-w-[64ch] lg:max-w-[90ch] text-block col-span-full lg:col-span-8 lg:col-start-3"><Content /></div>
			<div class="hidden lg:block col-span-2 col-start-11"></div>
		</div>
	</div>
</Wrapper>

			<!-- <figcaption class="mb-2 text-base text-left">
				<span>{shortDate} · {article.data.genre}{article.data.issue && ` · issue ${article.data.issue.toString().padStart(2, '0')}`}</span>
			</figcaption> -->