---
import { getCollection } from "astro:content";
import { Debug } from 'astro:components';
import Wrapper from "@components/Wrapper"
import VerticalBlock from "@components/VerticalBlock";
import { getEntries } from "astro:content";

export async function getStaticPaths() {
	const authors = await getCollection('authors')
	return authors.map((author) => {
		return {
			params: { author: author.slug},
			props: { author }
		};
	})
}

const { author } = Astro.props
const { Content } = await author.render()
// const articles = (await getCollection('articles'))
function slug2issue(slug) {
	console.log(slug);
	return parseInt(slug.split("/")[0].split("_")[1])
}
let articles = await getCollection('articles')
articles = articles.filter((x) => x.data.authors.map((y) => y.id).includes(author.slug))
	.sort((a, b) => (slug2issue(a.slug) < slug2issue(b.slug)) ? 1 : -1)
---

<Wrapper title={author} expand={true}>
	<div class="py-12" data-aos="fade-in">
		<div class="text-5xl lg:text-6xl font-bold mb-2">{author.data.name}</div>
		<div class="text-block-non-prose text-2xl text-left"><Content /></div>
	</div>

	{articles.map((i) => <VerticalBlock article={i} />)} 
</Wrapper>
