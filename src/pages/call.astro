---
// import { published } from "@data/post"
import { getCollection, getEntry } from "astro:content";
import Wrapper from "@components/Wrapper";
import CallBlock from "@components/CallBlock";

function padNumber(num: string, length: number) {
	return num.toString().padStart(length, '0');
}

let issues = (await getCollection('issues'))
let issue = issues.filter((i) => i.data.active)[0]
const ogUrl = Astro.site.origin + issue.data.image.src
const issueNumber = padNumber(issue.slug, 2);
let abstract = "issue " + issueNumber + " — " + issue.data.title
---

<Wrapper title="Disjunctions" image={ogUrl} abstract={abstract}>	
	<div class="flex flex-row flex-wrap justify-around items-stretch">
		<CallBlock issue={issue} />
	</div>
</Wrapper>
