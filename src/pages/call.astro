---
// import { published } from "@data/post"
import { getCollection, getEntry } from "astro:content";
import Wrapper from "@components/Wrapper";
import CallBlock from "@components/CallBlock";

let issues = (await getCollection('issues'))
let tot = issues.length
issues = issues.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Wrapper title="Disjunctions">	
	<div class="flex flex-row flex-wrap justify-around items-stretch">
		{issues.filter((i) => i.data.active).map((i, n) => <CallBlock issue={i} number={tot - 1 - n} />)}
	</div>


</Wrapper>
