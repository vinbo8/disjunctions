---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { Image } from "astro:assets"

import Wrapper from "@components/Wrapper"
import ArticleBanner from "@components/ArticleBanner";

export async function getStaticPaths() {
	const blogEntries = await getCollection('articles') 
	return blogEntries.map((article) => {
		return {
			params: { article: article.slug},
			props: { article }
		};
	})
}

const { article } = Astro.props
const ogImage = await getImage({src: article.data.image, width: 1200, height: 630})
const ogUrl = Astro.site.origin + ogImage.src
const { Content } = await article.render()
---

<Wrapper title={article.data.title} abstract={article.data.abstract} image={ogUrl}>
	<div class="flex flex-col items-center pb-8">
		<ArticleBanner entity={article} />
		<Image src={article.data.image} alt="" class="my-8 sm:mb-12 w-7/12 min-w-[480px] max-w-[960px] object-contain"
			   widths={[480, 640, 800, 960, 1280, 1600]} sizes="(max-width: 823px) 480px, (max-width: 1646px) 58.33vw, 960px" />
		<div class="relative grid grid-cols-12 w-full lg:px-[5%] overflow-visible">
			<div class="hidden lg:block col-span-2"><Image id="sideslash" class="sticky top-[50vh] mt-[50vh] -translate-y-1/2 self-start" src="/img/slash.png" height="100" width="100" alt="" /></div>
			<div id="body-text" class="prose text-block col-span-full lg:col-span-8 lg:col-start-3"><Content /></div>
			<div class="hidden lg:block col-span-2 col-start-11"></div>
		</div>
	</div>

	<script>
		const paragraphs = document.querySelectorAll("#body-text > p");
		[...paragraphs].map(p => p.setAttribute("data-aos", "fade-in"));
	</script>

</Wrapper>
