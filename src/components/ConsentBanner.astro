---
---
<!-- Modal -->
<div id="consent-modal" transition:persist class="fixed bottom-[2vw] right-1/2 translate-x-1/2 md:right-[2vw] md:translate-x-0 w-full max-w-md p-6 shadow-xl border text-black bg-white z-[9999] opacity-0 pointer-events-none transition-opacity duration-300 ease-out">
  <p class="mb-4 text-base">
    We use analytics cookies to understand how our site is used.
  </p>

  <div class="flex justify-end gap-3">
    <button onclick="acceptCookies()" class="cursor-pointer px-4 border py-2 text-sm border-black bg-p-blue text-white">Accept</button>
    <button onclick="rejectCookies()" class="cursor-pointer px-4 py-2 text-sm border hover:border-black transition-all duration-100">Reject</button>
  </div>
</div>

<script is:inline>
  const CONSENT_KEY = 'cookieConsent'
  const modal = document.getElementById('consent-modal')

  function showConsentModal() {
    modal.classList.remove('opacity-0', 'pointer-events-none')
    modal.classList.add('opacity-100')
  }

  function hideConsentModal() {
    modal.classList.remove('opacity-100')
    modal.classList.add('opacity-0', 'pointer-events-none')
  }

  function acceptCookies() {
    gtag('consent', 'update', {
      analytics_storage: 'granted'
    })
    localStorage.setItem(CONSENT_KEY, 'accepted')
    hideConsentModal()
  }

  function rejectCookies() {
    gtag('consent', 'update', {
      analytics_storage: 'denied'
    })
    localStorage.setItem(CONSENT_KEY, 'rejected')
    hideConsentModal()
  }

  function applyConsentState() {
    const consent = localStorage.getItem(CONSENT_KEY)
    if (!consent) {
      showConsentModal()
      return
    }

    const granted = consent === 'accepted'
    // Apply saved consent
    gtag('consent', 'update', {
      analytics_storage: consent === 'accepted' ? 'granted' : 'denied'
    })

    if (granted) {
      gtag('event', 'page_view')
    }
  }

  document.addEventListener('DOMContentLoaded', applyConsentState)
  document.addEventListener('astro:page-load', applyConsentState)

</script>