---
	import { Image } from 'astro:assets';
	import { Debug } from 'astro:components';
	import { getEntry, getEntries } from 'astro:content';
	import AuthorList from "@components/AuthorList"
	const { article, colour, mode = "default"} = Astro.props
	var date = article.data.date

	// const datestring = `${date.getDate()} ${date.toLocaleDateString(undefined, {month: 'long'})} ${date.getFullYear()}`
	const authors = await getEntries(article.data.authors)


	// skip everything to do with multiple block sizes
	// if (mode === "expand") {
	// 	article.data.block = 4
	// }
	// if (mode === "contract") {
	// 	article.data.block = 0
	// }
	// width = {1: "sm:w-3/12", 2: "sm:w-6/12", 3: "sm:w-9/12", 4: "sm:w-12/12", 0: "sm:w-4/12"}[article.data.block]
---

<div class="flex flex-col lg:flex-row py-8 group lg:w-max sm:w-1/2 space-x-4" data-aos="fade-in">
	<!-- <hr class="border-black border-b-0 mb-4"> -->
	<Image src={article.data.image} alt="" class="mb-6 object-contain object-left max-h-64 max-w-96 w-max" />
	<!-- <Debug block={article.data}/> -->
	<div class="text-left">
		<div class="font-sans font-semibold text-4xl mb-2"><a href={`/${article.slug}`}>{article.data.title}</a></div>
		<div class="font-serif text-xl mb-2 max-w-[64ch]"><a href={`/${article.slug}`}>{article.data.abstract}</a></div>
		<div class="font-serif text-base align-middle uppercase"><AuthorList authors={authors} /></div>
	</div>
</div>

			

<!-- {mode != 'contract' && <div class=`mb-6 font-serif italic ${tsize} text-black ${align}`>{article.data.abstract}</div>} -->