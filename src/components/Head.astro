---
import { ClientRouter } from "astro:transitions";

const {title, abstract, image, noindex} = Astro.props;
var summary = abstract ? abstract : "Disjunctions is a magazine dedicated to analysis and critique of contemporary technoscience"
var cover = image ? image : "https://disjunctionsmag.com/img/favicon.png"
---
<meta charset="utf-8" />
<title>{title}</title>

<link rel="icon" href="/img/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png" />
<link rel="manifest" href="/img/site.webmanifest">

<link rel="canonical" href="https://disjunctionsmag.com/" />
<meta name="description" content="Disjunctions is a magazine dedicated to analysis and critique of contemporary developments in science and technology." />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} >

<meta property="og:title" content={title}>
<meta property="og:site_name" content="Disjunctions">
<meta property="og:description" content={summary}>
<meta property="og:image" content={cover}>
<meta property="og:url" content="https://disjunctionsmag.com">
<meta property="og:type" content="website">

<meta name="twitter:card" content="summary">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={summary}>
<meta name="twitter:image" content="https://disjunctionsmag.com/img/favicon.png"> 
<meta name="twitter:image:alt" content="Disjunctions logo">

{noindex && <meta name="robots" content="noindex, nofollow">}

<ClientRouter />

<script is:inline>
function animate() {
    const animateElements = document.querySelectorAll(".animate");

    animateElements.forEach((element, index) => {
    setTimeout(() => {
        element.classList.add("show");
    }, index * 50);
    });
}
document.addEventListener("DOMContentLoaded", () => animate());
document.addEventListener("astro:after-swap", () => animate());
</script>

