---
const {title} = Astro.props;
---
<meta charset="utf-8" />
<title>{title}</title>
<link rel="icon" type="image/png" href="/img/favicon.svg" />
<link rel="canonical" href="https://disjunctionsmag.com/" />
<meta name="description" content="Disjunctions is a magazine dedicated to analysis and critique of contemporary developments in science and technology." />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} >

<meta property="og:title" content="Disjunctions Magazine">
<meta property="og:site_name" content="Disjunctions Magazine">
<meta property="og:description" content="Disjunctions is a magazine dedicated to analysis and critique of contemporary developments in science and technology." />
<meta property="og:image" content="https://disjunctionsmag.com/img/social-preview.png">
<meta property="og:url" content="https://disjunctionsmag.com">
<meta property="og:type" content="website">

<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Disjunctions Magazine">
<meta name="twitter:description" content="Disjunctions is a magazine dedicated to analysis and critique of contemporary developments in science and technology." />
<meta name="twitter:image" content="https://disjunctionsmag.com/img/social-preview.png"> 
<meta name="twitter:image:alt" content="The Disjunctions logo">


<script is:inline>
function animate() {
    const animateElements = document.querySelectorAll(".animate");

    animateElements.forEach((element, index) => {
    setTimeout(() => {
        element.classList.add("show");
    }, index * 50);
    });
}
document.addEventListener("DOMContentLoaded", () => animate());
document.addEventListener("astro:after-swap", () => animate());
</script>