---

import { Image } from "astro:assets"
import logoImage from "../../public/img/logo.svg"
import { Debug } from "astro:components";
const base_url = import.meta.env.BASE_URL

const { expand = true } = Astro.props;

let width = expand ? "w-3/4 md:w-full" : ""
let top_menu = expand ? "hidden md:flex" : "hidden"
---

<script>
	const maxHeaderHeight = 60
	const pageContent = document.querySelector('#page-content') as HTMLElement;
	const header = document.querySelector('#header') as HTMLElement;
	const hamburger = document.querySelector('#hamburger') as HTMLElement;
	const smallMenu = document.querySelector('#sm-menu') as HTMLElement;
	const largeMenu = document.querySelector('#lg-menu') as HTMLElement;
	const smallMenuItems = document.querySelectorAll('.small-menu-item') as NodeListOf<HTMLElement>;
	
	let lastScrollY = window.scrollY;

	function moveLargeMenu() {
		const headerHeight = header.offsetHeight;
		const headerWidth = header.offsetWidth;
		const fontHeight = largeMenu.offsetHeight;
		const padTop = parseInt(window.getComputedStyle(header)["padding-top"])
		const padBot = parseInt(window.getComputedStyle(header)["padding-bottom"])
		const imageHeight = headerHeight - (padTop + padBot); 
		const topLimit = padTop + (imageHeight * 0.95);
		const botLimit = headerHeight - (maxHeaderHeight / 2);
		const midpoint = (headerHeight + window.scrollY) / 2;

		let top = Math.max(topLimit, midpoint);
		top = Math.min(top, botLimit);
		top = top - (fontHeight / 2)
		let right = headerWidth * 0.08;

		largeMenu.style.top = `${top}px`
		largeMenu.style.right = `${right}px`
	}

	function hideSmallMenu() {
		if(!largeMenu.offsetParent) {
			if (window.scrollY > lastScrollY) {
				header.classList.add("-translate-y-full");
			} else {
				header.classList.remove("-translate-y-full");
			}
			lastScrollY = window.scrollY;
		}
	}

	function drawShadow() {
		// this is the check for whether or not we're in the big menu
		if(largeMenu.offsetParent) {
			const headerHeight = header.offsetHeight;
			const maxScroll = headerHeight - maxHeaderHeight;
			const scrollY = window.scrollY;
			const opacity = Math.min(0.1, (scrollY / (10 * maxScroll)))
			const shadowString = `0 2px 3px -1px rgba(0,0,0,${opacity}), 0 1px 2px -1px rgba(0,0,0,${opacity})`;
			header.style.boxShadow = shadowString;
		}
		else
		{
			header.style.boxShadow = "";
		}
	}

	function updateStickyOffset() {
		const viewportHeight = window.innerHeight;
		const headerHeight = header.offsetHeight;

		if (largeMenu.offsetParent) {
			header.style.top = `-${headerHeight - maxHeaderHeight}px`;
			if(smallMenu.classList.contains('show-nav')) {
				switchMenuType();
			}
		}
		else {
			header.style.top = "0px";
			smallMenu.style.top = `${headerHeight}px`;
			smallMenu.style.height = `${viewportHeight - headerHeight}px`;
		}
	}

	function switchMenuType() {
		pageContent.classList.toggle("hidden");
		smallMenu.classList.toggle('hide-nav');
		smallMenu.classList.toggle('show-nav');
	}

	function hideMenu() {
		smallMenu.classList.add("hide-nav")
		smallMenu.classList.remove("show-nav")
	}

	moveLargeMenu();
	drawShadow();
	updateStickyOffset();
    largeMenu.classList.toggle("invisible");
    largeMenu.classList.toggle("quick-animate");

	document.addEventListener('astro:after-preparation', hideMenu);
	hamburger.addEventListener('click', switchMenuType);
	window.addEventListener('resize', updateStickyOffset);
	window.addEventListener('resize', moveLargeMenu);
	window.addEventListener('resize', drawShadow);
	window.addEventListener('scroll', moveLargeMenu);
	// window.addEventListener('scroll', hideSmallMenu);
	window.addEventListener('scroll', drawShadow);

	const observer = new ResizeObserver(updateStickyOffset);
	observer.observe(document.querySelector('#header'));
</script>

<!-- includes mobile menu -->
<header id="header" transition:persist class="sticky z-50 top-0 bg-white flex flex-col items-center 
				h-full w-full font-serif px-[6vw] md:px-[2vw] py-[16px] md:pb-10 md:py-0 header-shadow md:shadow-none">
						   
	<!-- just the header -->
	<div class="flex flex-row md:flex-col w-full text-4xl items-center max-h-max">
		<!-- large menu -->
		<div class="hidden md:flex w-full overflow-hidden justify-start print:w-full print:justify-center">
			<a href="/" class="block w-full"><Image src={logoImage} alt="" inferSize class="h-auto w-full" /></a>		
		</div>
		<!-- also large menu -->
		<ul id="lg-menu" class="hidden md:flex invisible ml-auto space-x-20 absolute top-0 right-0 
					md:text-xl lg:text-2xl xl:text-3xl">
			<li><a href="/">articles</a></li>
			<li><a href="/issues">issues</a></li>
			<li><a href="/support">support</a></li>
			<li><a href="/about">about</a></li>

		</ul>

		<div class="flex md:hidden w-3/4 max-w-[320px] overflow-hidden justify-start print:w-full print:justify-center">
			<a href="/" class="block w-full"><Image src={logoImage} alt="" inferSize class="h-auto w-full" /></a>		
		</div>

		<div class="w-1/4 flex-grow md:hidden print:hidden text-right flex flex-row justify-end">
			<button id="hamburger">
				<svg viewBox="0 0 24 24" fill="none" class="w-8 h-8" xmlns="http://www.w3.org/2000/svg">
					<path d="M5 8 H19 M5 12 H19 M5 16 H19" stroke="#464455" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
		</div>

	</div>
	<div id="sm-menu" class="text-2xl flex md:hidden flex-col border-black hide-nav w-full bg-white z-50 fixed items-center justify-center">
		<div class="small-menu-item py-2"><a href="/">articles</a></div>
		<div class="small-menu-item py-2"><a href="/issues">issues</a></div>
		<div class="small-menu-item py-2"><a href="/support">support</a></div>
		<div class="small-menu-item py-2"><a href="/about">about</a></div>
	</div>
</header>




