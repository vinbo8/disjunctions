---
import { Image } from "astro:assets"
import AuthorList from "./AuthorList.astro";
import { getEntries } from "astro:content";

const { entity } = Astro.props;

const authors = await getEntries(entity.data.authors).catch(() => null);
const shortDate = new Date(entity.data.date).toLocaleDateString("en-US", {month: "short", year: "numeric"}).toLowerCase();
---

<div class="grid grid-cols-[1fr_auto_1fr] w-full items-start">
	<span class="col-span-3 font-sans text-4xl md:text-5xl lg:text-6xl font-bold leading-[0.9] mb-2" set:html={entity.data.title}></span>
	<span class="col-span-3 font-serif text-2xl md:text-3xl lg:text-4xl italic mb-4">{entity.data.abstract}</span>
	<div class="flex flex-row col-span-2 gap-4 justify-between font-serif text-lg md:text-xl lg:text-2xl">
		<span class="small-caps"><AuthorList authors={authors} /></span>
		<span class="">{shortDate} · {entity.data.genre}{entity.data.issue && ` · issue ${entity.data.issue.toString().padStart(2, '0')}`}</span>
	</div>

	<figure class="col-start-2 mb-8 sm:mb-12 mt-8 w-full max-w-[880px] lg:max-w-[640px] xl:max-w-[768px] 2xl:max-w-[960px] object-cover">
		<Image src={entity.data.image} alt="" class="" widths={[480, 640, 800, 960, 1280, 1600]} sizes="(max-width: 823px) 480px, (max-width: 1646px) 58.33vw, 960px" />
		<figcaption class="mt-2 text-xs text-left">
			<span>{entity.data.caption}</span>
		</figcaption>
	</figure>
</div>