---
import { Image } from "astro:assets"
import AuthorList from "./AuthorList.astro";
import { getEntries } from "astro:content";

const { entity } = Astro.props;
const { Content } = await entity.render();

let authors = null;

let authorlink = true;
if (entity.data.authors) {
	authors = await getEntries(entity.data.authors)
	if (entity.data.authors[0]['id'] === "the-editors") {
		authorlink = false
	} 
}


if (entity.data.colour === null) {
	entity.data.colour = '#ffffff'
}
---

<!-- <div class="border-b-2 border-black" style={`background-color: ${entity.data.colour}`}>	 -->
<div class="flex flex-row items-center mb-8 pt-12 lg:pt-16 w-full gap-x-12 print:justify-center" data-aos="fade-in">
	<!-- <Image src={entity.data.image} alt="" class="block mb-8 max-h-72 w-auto object-contain" /> -->
	<div class="text-left max-w-3xl flex flex-col print:text-center">
		<div class="text-5xl lg:text-6xl font-bold mb-2">{entity.data.title ? entity.data.title:entity.data.name}</div>
		<div class="font-serif text-xl lg:text-2xl italic mb-6">{entity.data.abstract ? entity.data.abstract:<Content />}</div>
		{authors && <div class="font-serif text-base lg:text-lg uppercase"><AuthorList authors={authors} authorlink={authorlink} /><br></div>}
	</div>
</div>