---
import { Image } from "astro:assets"
import AuthorList from "./AuthorList.astro";
import { getEntries } from "astro:content";

const { entity } = Astro.props;
const { Content } = await entity.render();

const authors = await getEntries(entity.data.authors).catch(() => null);

if (entity.data.colour === null) {
	entity.data.colour = '#ffffff'
}
---

<!-- <div class="border-b-2 border-black" style={`background-color: ${entity.data.colour}`}>	 -->
<div class="flex flex-row items-center mb-8   w-full gap-x-12 print:justify-center">
	<!-- <Image src={entity.data.image} alt="" class="block mb-8 max-h-72 w-auto object-contain" /> -->
	<div class="text-left max-w-4xl flex flex-col print:text-center">
		<div class="text-4xl md:text-5xl lg:text-6xl font-bold leading-[0.9] mb-2" set:html={entity.data.name}></div>
		<div class="font-serif text-base md:text-lg tracking-tight lg:text-xl mb-8"><Content /></div>
	</div>
</div>