---
	const { authors } = Astro.props
	const hideLink = authors.map(a => a.slug).includes('the-editors')
---
{
	authors.map((author, i, {length}) => {
		if (length - 1 === i) {
			return <span>{hideLink ? 
							( <>{author.data.name}</> ):
							( <a href={`/authors/${author.slug}`}>{author.data.name}</a> )}
					</span>
		}
		else {
			return <span><a href={`/authors/${author.slug}`}>{author.data.name}</a> & </span>
		}
	})
}
<!-- class="align-top font-sans text-black text-base" -->