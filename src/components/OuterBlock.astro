---
	import { Image } from 'astro:assets';
	import { Debug } from 'astro:components';
	import { getEntry, getEntries } from 'astro:content';
	import AuthorList from "@components/AuthorList"
	const { article, colour, isTrio = true} = Astro.props
	var date = article.data.date

	const calc = isTrio ? 29.33 : 44

	// const datestring = `${date.getDate()} ${date.toLocaleDateString(undefined, {month: 'long'})} ${date.getFullYear()}`
	const authors = await getEntries(article.data.authors)

---

<div class:list={{
		"flex flex-col py-8 px-12 group border-b-0 border-black sm:w-1/2 flex-grow": true,
 		"md:w-1/3": isTrio,
		"md:w-1/2": !isTrio
		}} style={`border-color: ${colour}`} data-aos="fade-in">
	<Image src={article.data.image} widths={[320, 640]} sizes="(max-width: 768px) 50vw 33vw" alt="" class="mb-6 mx-auto object-contain max-h-96 max-w-full md:w-[calc(29.33vw-96px)]" />
	<div class="text-center font-serif text-3xl lg:text-3xl mb-2"><a href={`/${article.slug}`}>{article.data.title}</a></div>
	<div class="text-center font-serif text-sm lg:text-sm align-middle uppercase"><AuthorList authors={authors} /></div>
</div>
