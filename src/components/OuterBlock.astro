---
	import { Image } from 'astro:assets';
	import { Debug } from 'astro:components';
	import { getEntry, getEntries } from 'astro:content';
	import AuthorList from "@components/AuthorList"
	const { article, colour, isTrio = true} = Astro.props
	var date = article.data.date

	// const datestring = `${date.getDate()} ${date.toLocaleDateString(undefined, {month: 'long'})} ${date.getFullYear()}`
	const authors = await getEntries(article.data.authors)

---

<div class:list={{
		"flex flex-col mb-8 px-12 border-b-0 border-black sm:w-1/2 flex-grow": true,
 		"md:w-1/3": isTrio,
		"md:w-1/2": !isTrio
		}} style={`border-color: ${colour}`}>
	<div class="text-center font-sans text-xs mb-2">{article.data.genre}</div>
	<div class="relative inline-block group mb-6 mx-auto object-contain max-h-96 max-w-full md:w-[calc(29.33vw-96px)]">
		<a href={`/${article.slug}`}><Image src={article.data.image} widths={[320, 640]} sizes="(max-width: 768px) 50vw 33vw" alt={article.data.title} /></a>
		<div class="bg-p-blue pointer-events-none absolute inset-0 mix-blend-hue opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
	</div>
	<div class="text-center font-serif text-3xl lg:text-3xl mb-2"><a href={`/${article.slug}`}>{article.data.title}</a></div>
	<div class="text-center font-serif text-sm lg:text-sm align-middle uppercase"><AuthorList authors={authors} /></div>
</div>
