---
import { Image } from 'astro:assets';
import { Debug } from 'astro:components';
import { getCollection } from 'astro:content';
const { issue, rtl=false } = Astro.props
const { Content } = await issue.render()

function padNumber(num: string, length: number) {
	return num.toString().padStart(length, '0');
}
const issueNumber = padNumber(issue.slug, 2);

const dateOptions = {year: 'numeric', month: 'long'};
const date = issue.data.date.toLocaleDateString('en-GB', dateOptions);
let articles = await getCollection('articles')
articles = articles.sort((a, b) => a.data.date < b.data.date ? -1 : 1).filter((a) => a.data.issue == issue.slug)
const allAuthors = await getCollection('authors')

const articlesWithAuthors = articles.map(article => {
	const authorIds = (article.data.authors ?? []).map(a => a.id);
	// const authors = allAuthors.filter(a => authorIds.includes(a.slug));
	const authors = authorIds.map(id => allAuthors.find(a => a.slug === id)).filter(Boolean); 
	return {
		...article,
		authors
	};
});
---

<div class=`flex flex-col items-center w-full lg:items-stretch text-center lg:text-left lg:mb-16 ${rtl ? 'lg:flex-row-reverse lg:text-right' : 'lg:flex-row lg:text-left'}`>
	<Image class=`lg:self-start max-w-lg w-9/12 min-w-8 max-h-96 lg:max-h-max lg:w-[30%] object-contain mb-8 lg:mb-0 ${rtl ? 'lg:ml-8' : 'lg:mr-8'}` src={issue.data.image} alt={issue.data.title} width={512} sizes="(min-width: 1024px) 30vw, 75vw" />
	<div class="lg:px-0 lg:w-[60%]">
		<h1 id="title" class="mb-0 font-bold font-serif leading-[0.8] text-[clamp(4rem,7.25vw,7rem)]">issue {issueNumber}</h1>
		<h2 id="subtitle" class="mb-8 font-semibold font-sans leading-[0.9] -translate-y-[15%] text-[clamp(2rem,3.6vw,3.5rem)] whitespace-break-spaces">{issue.data.title}</h2>
		<div class="prose max-w-max text-black text-block">
			<Content />
		</div>
	</div>
</div>