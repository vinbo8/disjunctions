---
import { Image } from "astro:assets"
import logoImage from "../../public/img/favicon_old.svg"
---
<footer transition:persist>
    <div class="flex flex-row flex-wrap my-8 justify-center items-start px-[8vw] gap-y-8 font-serif text-xl">
        <div class="flex flex-col flex-[1_1_0%] min-w-[100px] basis-1/4 items-start">
          <span><a href="/call">issue 02</a></span>
          <span><a href="/">articles</a></span>
          <span><a href="/issues">issues</a></span>
          <span><a href="/support">support</a></span>
        </div>

        <div class="flex flex-col flex-[1_1_0%] min-w-[100px]  basis-1/4 items-start">
          <span><a href="/about">about</a></span>
          <span><a href="mailto:contact@disjunctionsmag.com">contact us</a></span>
          <span><a href="/rss">rss</a></span>
        </div>

        <div class="flex flex-col flex-[1_1_0%] min-w-[100px] basis-1/4 items-start">
          <span><a href="https://www.instagram.com/disjunctionsmag/">instagram</a></span>
          <span><a href="https://bsky.app/profile/disjunctionsmag.bsky.social">bluesky</a></span>
        </div>

        <div class="flex flex-col min-w-[200px] flex-[2_0_0%] basis-1/4">
            <span id="signup-text" class="transition">subscribe to our newsletter</span>
            <form id="signup-form" class="flex flex-col">
              <input id="email" type="text" placeholder="email address" class="italic max-w-fit border-b-2 mb-2 bg-white text-black focus:outline-none" />
              <button type="submit" class="border max-w-fit px-1 hover:bg-p-blue hover:text-white transition">sign up</button>
            </form>
        </div>
    </div>
</footer>

<script>
document.getElementById("signup-form").addEventListener("submit", async function(e) {
  e.preventDefault();

  const emailInput = document.getElementById("email") as HTMLInputElement | null;
  if (!emailInput) return;
  const email = emailInput.value;

  const span = document.getElementById("signup-text");

  const response = await fetch(
    "https://api.convertkit.com/v3/forms/8956168/subscribe",
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        api_key: "bvoR-mK-CC2ysnI8dwr6bA",
        email: email,
        form_id: 8956168
      })
    }
  );

  span.style.opacity = "0";
  if (response.ok) { 
    // span.textContent = "tank you for subscribing!"
    setTimeout(() => {
      span.textContent = "thank you!";
      span.style.opacity = "1";
  }, 300);
    this.toggleAttribute("hidden");
  }
  else {
    setTimeout(() => {
      span.textContent = "something went wrong";
      span.style.opacity = "1";
  }, 300);
    this.toggleAttribute("hidden");
  }
  console.log(response);
  // console.log(response);
//   if (!response.ok) span.textContent = "Failed"
//   this.toggleAttribute("hidden")
//   span.toggleAttribute("hidden")

});
</script>