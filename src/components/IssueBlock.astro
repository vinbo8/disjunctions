---
	import { Image } from 'astro:assets';
	const { issue, number } = Astro.props
	const { Content } = await issue.render()

	function padNumber(num, length) {
  		return (num + 1).toString().padStart(length, '0');
	}
	const issueNumber = padNumber(number, 2);

	const dateOptions = {year: 'numeric', month: 'long'};
	const mode = issue.data.mode;
	const date = issue.data.date.toLocaleDateString('en-GB', dateOptions);
---

<script>
	function getSize(element) {
		const elementFontSizePx = parseFloat(getComputedStyle(element).fontSize);
		const rootFontSizePx = parseFloat(getComputedStyle(document.documentElement).fontSize);
		const fontSizeInRem = elementFontSizePx / rootFontSizePx;
		return fontSizeInRem;
	}

	function logSizes() {
		let title = document.getElementById("title");
		let subtitle = document.getElementById("subtitle");
		console.log(getSize(title) + "rem\t" + getSize(subtitle) + "rem");
	}
	window.addEventListener('resize', logSizes);
	logSizes();

</script>

<div class="flex flex-col lg:flex-row py-24 items-center w-full lg:items-stretch text-center lg:text-left">
	<Image class="max-w-lg w-9/12 min-w-8 max-h-96 lg:max-h-max lg:w-[30%] object-contain mb-8 lg:mb-0 lg:mr-8"  src={issue.data.image} alt={issue.data.title} width={512} sizes="(min-width: 1024px) 30vw, 75vw" />
	<div class="lg:px-0 lg:w-[60%]">
		<h1 id="title" class="mb-0 font-bold font-serif leading-[1] text-[clamp(4rem,7.25vw,7rem)]">issue {issueNumber}</h1>
		<h2 id="subtitle" class="mb-4 font-semibold font-sans leading-[0.9] -translate-y-[15%] text-[clamp(2rem,3.6vw,3.5rem)] whitespace-break-spaces">{issue.data.title}</h2>
		<div class="prose text-block mx-0">
			{mode === "display" ? <Content />
								: <Image id="sideslash" class="object-contain mx-auto lg:mx-0" src="/img/slash.png" height="100" width="100" alt="" />
			}
		</div>
	</div>
</div>