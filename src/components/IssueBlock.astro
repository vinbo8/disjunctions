---
import { Image } from 'astro:assets';
import { Debug } from 'astro:components';
import { getCollection } from 'astro:content';
const { issue, number } = Astro.props
const { Content } = await issue.render()

function padNumber(num, length) {
	return (num + 1).toString().padStart(length, '0');
}
const issueNumber = padNumber(number, 2);

const dateOptions = {year: 'numeric', month: 'long'};
const date = issue.data.date.toLocaleDateString('en-GB', dateOptions);
let articles = await getCollection('articles')
articles = articles.sort((a, b) => a.data.date < b.data.date ? -1 : 1).filter((a) => a.data.issue == issue.slug)
const allAuthors = await getCollection('authors')

const articlesWithAuthors = articles.map(article => {
	const authorIds = (article.data.authors ?? []).map(a => a.id);
	// const authors = allAuthors.filter(a => authorIds.includes(a.slug));
	const authors = authorIds.map(id => allAuthors.find(a => a.slug === id)).filter(Boolean); 
	return {
		...article,
		authors
	};
});
---

<div class="flex flex-col lg:flex-row items-center w-full lg:items-stretch text-center lg:text-left">
	<Image class="max-w-lg w-9/12 min-w-8 max-h-96 lg:max-h-max lg:w-[30%] object-contain mb-8 lg:mb-0 lg:mr-8" src={issue.data.image} alt={issue.data.title} width={512} sizes="(min-width: 1024px) 30vw, 75vw" />
	<div class="lg:px-0 lg:w-[60%]">
		<h1 id="title" class="mb-0 font-bold font-serif leading-[1] text-[clamp(4rem,7.25vw,7rem)]">issue {issueNumber}</h1>
		<h2 id="subtitle" class="mb-4 font-semibold font-sans leading-[0.9] -translate-y-[15%] text-[clamp(2rem,3.6vw,3.5rem)] whitespace-break-spaces">{issue.data.title}</h2>
		<div class:list={{"prose": issue.data.active}}>
			{issue.data.active ? 
				<Content /> :
				<div class="text-lg md:text-2xl font-sans text-black font-medium">
					{articlesWithAuthors.map((a) => 
						<div class="mb-1 ">
							{a.data.draft ? (
								<span>{a.data.title}</span>
								) : (
								<span class="underline"><a href={a.slug}>{a.data.title}</a></span>
							)}
							<span class="inline-block px-2">/</span>
							<span>{a.authors.map(w => w.data.name).join(" & ")}</span>
						</div>
					)}
				{/* <Image id="sideslash" class="object-contain mx-auto lg:mx-0" src="/img/slash.png" height="100" width="100" alt="" /> */}
				</div>
			}
		</div>
	</div>
</div>